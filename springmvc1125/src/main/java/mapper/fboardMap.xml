<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
    PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
    "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="fb">
<select id="list" resultType="fvo"> SELECT num,subject,writer,hit,fdate FROM FBOARD ORDER BY 1 DESC </select>
<insert id="add" parameterType="fvo"> INSERT INTO FBOARD VALUES(fboard_seq.NEXTVAL,#{subject},#{content}, #{writer},#{reip},0,#{pwd},sysdate) </insert>
<update id="hit" parameterType="int"> UPDATE fboard SET hit=hit+1 WHERE num=#{num} </update>
<update id="update" parameterType="fvo">
<!--  fboard테이블에 있는 내용 중 전달받은 글 번호와 일치하는 게시물을 가져와서 새로운 내용(#단으로)을 수정한다.   -->
UPDATE fboard SET subject=#{subject},writer=#{writer},content=#{content} WHERE num=#{num}
</update>
<select id="detail" parameterType="int" resultType="fvo"> SELECT num,subject,content,writer,reip,hit,fdate FROM fboard WHERE num=#{num} </select>
<!--  Dao에 가져올 id를 delete로 지정하고 매개변수를 int로 선언한다.  -->
<delete id="delete" parameterType="int">
<!--  Fboard에 있는 내용 중 글번호와 일치하는 게시물을 가져와서 내용을 지운다.  -->
DELETE FROM fboard WHERE num=#{num}
</delete>
</mapper>